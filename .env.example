# ══════════════════════════════════════════════════════════════════════════════
# FLO STUDIOS — SUPABASE ENVIRONMENT CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
# 1. Sign in to https://supabase.com/dashboard
# 2. Select your project -> Project Settings -> API
# 3. Copy your Project URL and Publishable 'anon' public key below
# 4. Save a copy of this file as .env or .env.local

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# Optional offline preview passcode (leave empty to require Supabase Auth)
VITE_ADMIN_PASSCODE=
